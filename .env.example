# Root Environment Variables Template
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database
DATABASE_URL="mysql://root:admin@localhost:3306/hireai_ats"

# Auth
JWT_SECRET=hireai-super-secret-jwt-key-change-in-production-2026
JWT_REFRESH_SECRET=hireai-super-secret-refresh-key-change-in-production-2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Service
OPENAI_API_KEY=your-openai-api-key
DEMO_MODE=true

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=hireai-resumes
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email
EMAIL_API_KEY=resend-or-smtp-api-key
EMAIL_FROM=noreply@hireai.com
